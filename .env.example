# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real API keys.

# Which provider baseline/advanced call. "anthropic" (default) or "gemini".
LLM_PROVIDER=anthropic

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-opus-5.
ANTHROPIC_MODEL=

# --- Gemini (used when LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=
# Optional override, defaults to gemini-2.5-flash. Google ships new model
# generations faster than this default gets updated -- set this explicitly
# to whatever's current for your key if the default 404s.
GEMINI_MODEL=
